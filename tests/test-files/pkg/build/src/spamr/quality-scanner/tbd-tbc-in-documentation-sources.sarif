        },
        {
          "location": {
            "uri": "file:///doc/a.rst"
          },
          "properties": {
            "kind": "document",
            "path": "source/a.rst",
            "uid": "/pkg/source/doc-a"
          }
        },
        {
          "location": {
            "uri": "file:///doc/b.md"
          },
          "properties": {
            "kind": "document",
            "path": "b.md",
            "uid": "/pkg/source/doc-b"
