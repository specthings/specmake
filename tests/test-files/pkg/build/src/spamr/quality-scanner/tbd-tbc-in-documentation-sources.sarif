{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "artifacts": [
        {
          "location": {
            "uri": "file:///spec/rtems/req/action.yml"
          },
          "properties": {
            "kind": "item",
            "uid": "/rtems/req/action"
          }
        },
        {
          "location": {
